{
  "name": "cyberpunk-red-combat-assistant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test \"src/**/*.test.js\"",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "npm run build && electron .",
    "dist:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.cyberpunk.red.combat.assistant",
    "productName": "Cyberpunk RED Combat Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
